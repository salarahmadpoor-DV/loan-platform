{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Jwt": {
    "Key": "",
    "Issuer": "Matchi",
    "Audience": "Matchi"
  },

  "Seed": {
    "Enabled": false
  },

  "Otp": {
    "TtlMinutes": 5,
    "MaxAttempts": 5
  },

  "LocationResolver": {
    "Mode": "Auto",
    "ExternalEnabled": true,
    "TimeoutMs": 1500,
    "FallbackToInternal": true,
    "External": {
      "BaseUrl": "",
      "UserAgent": "Matchi/1.0 (location-resolver)"
    }
  }
}

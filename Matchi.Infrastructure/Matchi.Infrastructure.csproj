<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Matchi.Domain\Matchi.Domain.csproj" />
    <ProjectReference Include="..\Matchi.Application\Matchi.Application.csproj" />
    <ProjectReference Include="..\Matchi.Shared\Matchi.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>


  </ItemGroup>

  <ItemGroup>
    <!-- Historical migrations that must not run against live MatchiDb. Not part of the active EF chain. -->
    <Compile Remove="Persistence\Migrations\ArchivedIncompatible\**\*" />
    <None Include="Persistence\Migrations\ArchivedIncompatible\**\*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


</Project>